# Copiar a .env.local para desarrollo. En Cloudflare Pages cargar estas
# variables en Settings > Environment variables (secretos marcados como "Encrypt").

# --- Build (Next, público) ---
# URL final del sitio. Sin dominio propio: la URL de *.pages.dev.
NEXT_PUBLIC_SITE_URL=https://draiaccarino.pages.dev
# Site key pública de Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Pages Function (runtime, secretos) ---
# Secret key de Turnstile.
TURNSTILE_SECRET_KEY=
# Opcional: hostname esperado para validar el token (ej. proyecto-andrea.pages.dev).
SITE_HOSTNAME=
# API key de Resend.
RESEND_API_KEY=
# Destino de las notificaciones (Gmail actual).
CONTACT_TO_EMAIL=andrealaura.iaccarino@gmail.com
# Remitente. Sin dominio verificado: onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev
# Clave aleatoria larga para hashear IPs (openssl rand -hex 32).
IP_HASH_SECRET=
