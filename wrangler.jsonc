{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "draiaccarino",
  "main": "src/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": false,
    "not_found_handling": "404-page"
  },
  "compatibility_date": "2026-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "db-draiaccarino",
      "database_id": "0210db08-8918-4e73-9d94-fb056ac66358",
      "migrations_dir": "migrations"
    }
  ]
}